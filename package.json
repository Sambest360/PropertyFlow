{
  "name": "propertyflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,vite -c cyan,magenta \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:logs": "docker compose -f docker-compose.db.yml logs -f db",
    "db:schema": "sh -c 'psql \"${DATABASE_URL:-postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow}\" -v ON_ERROR_STOP=1 -f database/postgres/schema.sql'",
    "db:schema:remote": "psql \"$DIRECT_URL\" -f database/postgres/schema.sql",
    "db:migrate": "sh -c 'psql \"${DATABASE_URL:-postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow}\" -v ON_ERROR_STOP=1 -f database/postgres/migrations/001_performance_indexes.sql'",
    "db:migrate:auth": "psql \"$DIRECT_URL\" -f database/postgres/migrations/002_supabase_auth.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/003_rls_bootstrap.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/004_ensure_user_profile.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/005_public_listing_enquiry.sql",
    "db:setup:remote:empty": "psql \"$DIRECT_URL\" -f database/postgres/schema.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/001_performance_indexes.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/002_supabase_auth.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/003_rls_bootstrap.sql && psql \"$DIRECT_URL\" -f database/postgres/migrations/004_ensure_user_profile.sql",
    "db:super-admin": "tsx scripts/create-super-admin.ts",
    "db:repair-auth": "tsx scripts/repair-auth-identities.ts",
    "db:seed:supabase": "tsx scripts/seed-supabase-demo.ts",
    "db:seed:applicants": "tsx scripts/seed-applicants.ts",
    "db:seed": "sh -c 'psql \"${DATABASE_URL:-postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow}\" -v ON_ERROR_STOP=1 -f database/postgres/seed_empty.sql'",
    "db:seed:demo": "sh -c 'psql \"${DATABASE_URL:-postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow}\" -v ON_ERROR_STOP=1 -f database/postgres/seed.sql && psql \"${DATABASE_URL:-postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow}\" -v ON_ERROR_STOP=1 -f database/postgres/seed_pe_bulk.sql'",
    "db:reset": "npm run db:schema && npm run db:seed",
    "db:reset:demo": "npm run db:schema && npm run db:seed:demo",
    "db:gen-pe-bulk": "tsx scripts/gen-pe-bulk-sql.ts",
    "email:test": "tsx scripts/sendTestEmail.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@react-google-maps/api": "^2.20.8",
    "@sentry/node": "^9.47.2",
    "@sentry/react": "^9.47.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "hono": "^4.12.32",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "mailtrap": "^4.10.0",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
