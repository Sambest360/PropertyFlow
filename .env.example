# Letkaya is a Vite SPA. Only VITE_* vars are exposed to the client bundle.
# Do not put secrets here or in any VITE_* variable that must stay private —
# Google Maps browser keys should be HTTP-referrer restricted in Google Cloud.
#
# Copy to `.env.local` and restart `npm run dev`.

# Dev-only: set to 1 with `npm run dev:full` to enable the Hono API + Postgres bootstrap.
# Leave unset (default) for fast Vite-only `npm run dev`.
# VITE_ENABLE_API=1

# Optional product label
# VITE_APP_NAME=Letkaya

# Dev-only RoleSwitcher (persona hopping). Leave unset for real auth UX.
# VITE_DEMO_SWITCHER=1

# Google Maps Platform (optional — Maps JavaScript API + Geocoding + Places recommended)
# 1. Google Cloud → enable Maps JavaScript API (and Places if using address autocomplete)
# 2. Credentials → API key → Application restrictions: HTTP referrers
#    e.g. http://localhost:5173/*  https://lekayarentals.site/*
# 3. Paste the key below. Leave blank to use the branded Leaflet/Carto Positron map (no key required).
# When set, the browse / listing maps use Letkaya-styled Google Maps instead.
VITE_GOOGLE_MAPS_API_KEY=

# Optional base for demo document sample PDFs (defaults to a stable W3C sample PDF)
# VITE_DEMO_DOCS_BASE_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources

# --- Server-only (Hono API — never use VITE_ prefix) ---
# Free local Postgres (Docker — recommended for $0 dev): npm run db:up && npm run db:reset
# DATABASE_URL=postgresql://propertyflow:propertyflow@127.0.0.1:5433/propertyflow
# Native Postgres (auto-used when DATABASE_URL is unset — see server/dbConfig.ts):
# DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/propertyflow
#
# Production server (.env in /var/www/propertyflow) — restart the API after changes
# (pm2 restart propertyflow-api):
# DATABASE_URL=postgresql://propertyflow:PASSWORD@127.0.0.1:5432/propertyflow
# AUTH_SECRET=<long random string>
# DB_POOL_MAX=10
# Listing photos are saved on the server's disk under UPLOADS_DIR (default ./uploads).
# UPLOADS_DIR=/var/www/propertyflow/uploads
DATABASE_URL=

# API_PORT=8787
# REQUIRED: AUTH_SECRET must be set to a unique, cryptographically secure random string
# Generate a secure value: openssl rand -hex 32
# This is used to sign all JWT session tokens. DO NOT use the default below in production.
# If running locally with a placeholder, use: openssl rand -hex 32 | tr -d '\n'
AUTH_SECRET=

# Server mode. Production (the Ubuntu server) MUST run with NODE_ENV=production.
# Unset or anything else = identity only from the signed-in session.
# NODE_ENV=production
# Local dev only: trust X-User-Id / X-Role demo headers (RoleSwitcher without a session).
# Ignored whenever NODE_ENV=production.
# ALLOW_DEMO_ACTOR=1

# Comma-separated extra browser origins for CORS
# CORS_ORIGINS=https://propertyflow.example.com

# Optional: absolute API origin if not using the Vite `/api` proxy
# VITE_API_BASE=

# --- PayFast ---
# Sandbox credentials from https://sandbox.payfast.co.za (Merchant settings).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PAYFAST_PUBLIC_URL=http://127.0.0.1:5173

# --- Email (account emails + every notification) ---
# Sender (a no-reply address on your domain, verified in Brevo):
EMAIL_FROM=info@lekayarentals.site
EMAIL_FROM_NAME=Lekaya Rentals
# Links in emails point here:
PUBLIC_APP_URL=https://lekayarentals.site
# Provider: brevo | smtp | mailtrap | log. Leave blank to pick the first one configured.
# EMAIL_PROVIDER=
# Brevo transactional API key ("xkeysib-…", Brevo → SMTP & API → API keys):
BREVO_API_KEY=
# …or Brevo SMTP relay with an SMTP key ("xsmtpsib-…"); SMTP_USER is the login Brevo shows there:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Landlord copies of listing-enquiry alerts (enquirer's name, email, phone, note).
# OFF by default: only the agent is alerted. Set to exactly 1 only once a data
# processing agreement and sender verification are in place.
# ALERT_LANDLORDS=1
# Notification emails run every minute in the API; set to off to pause them.
# NOTIFICATION_EMAILS=on
# Test: npx tsx scripts/sendTestEmail.ts you@example.com

# --- Mailtrap (older option, kept for testing) ---
# Transport: 'smtp' (default when SMTP creds present) or 'api'.
MAILTRAP_TRANSPORT=
# SMTP credentials: https://mailtrap.io/inboxes → SMTP Settings (sandbox host
# is sandbox.smtp.mailtrap.io, ports 25/465/587/2525).
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# API alternative: token with Send access https://mailtrap.io/settings/api-tokens
# Delivery logs: https://mailtrap.io/sending/email_logs
# API sandbox sends need MAILTRAP_INBOX_ID; set MAILTRAP_USE_SANDBOX=false for
# live sending from a verified domain (https://mailtrap.io/domains).
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=Letkaya
# Recipient for `npm run email:test`
MAILTRAP_TEST_TO=

# --- DQ-M4 email dunning (optional Mailtrap) ---
# Default OFF: unset/false → never email; in-app dunning still works.
# When true: staff "Send dunning notice" may also fire category `rent-dunning`
# via Mailtrap (sandbox) — not WhatsApp/SMS/carrier success.
# ENABLE_EMAIL_DUNNING=false
# Alias also accepted: DUNNING_EMAIL_ENABLED


# --- Screening / credit bureau (roadmap Step 4) ---
# Default mock provider — no live bureau calls.
# SCREENING_PROVIDER=mock
# Live TPN (or similar) needs partner keys — do not invent credentials.
# SCREENING_PROVIDER=tpn
# SCREENING_TPN_API_KEY=
# SCREENING_TPN_API_URL=
# SCREENING_TPN_WEBHOOK_SECRET=
# Webhook ingest: POST /api/screening/webhook  (shape validated; persistence partner-gated)

# --- E-sign / lease PDF (roadmap Step 5 + DQ-C1 Mode A) ---
# Default mock provider — non-production soft-demo, no partner API calls.
# ESIGN_PROVIDER=mock
# Live SigniFlow (server-only secrets — NEVER VITE_ESIGN_SIGNIFLOW_*):
# ESIGN_PROVIDER=signiflow
# ESIGN_SIGNIFLOW_API_KEY=
# ESIGN_SIGNIFLOW_API_URL=https://flow.signflow.co.za/API/SignFlowAPIServiceRest.svc
# Optional token expiry for TokenField (default 2030-12-31T23:59:59Z):
# ESIGN_SIGNIFLOW_TOKEN_EXPIRY=2030-12-31T23:59:59Z
# Optional webhook shared secret for POST /api/esign/webhook:
# ESIGN_SIGNIFLOW_WEBHOOK_SECRET=
# DocuSign remains a placeholder (Mode A OUT) — do not invent live HTTP.
# ESIGN_PROVIDER=docusign
# ESIGN_DOCUSIGN_INTEGRATION_KEY=
# ESIGN_DOCUSIGN_ACCOUNT_ID=
# ESIGN_DOCUSIGN_API_URL=
# Optional client hint only (no secrets): VITE_ESIGN_PROVIDER=mock|signiflow
# When VITE_ESIGN_PROVIDER=signiflow, FE calls /api/esign/* ; keys stay on server.
# See docs/signiflow-going-live.md

# --- Cron jobs (server crontab from deploy/setup.sh, e.g. GET /api/cron/lease-reminders daily) ---
# Required: the crontab sends `Authorization: Bearer $CRON_SECRET`. Unset -> route returns 503.
# CRON_SECRET=<long random string>
# Optional email copy of the reminder via Mailtrap (default OFF).
# ENABLE_EMAIL_LEASE_REMINDER=0
