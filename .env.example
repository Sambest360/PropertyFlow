# PropertyFlow is a Vite SPA. Only VITE_* vars are exposed to the client bundle.
# Do not put secrets here or in any VITE_* variable that must stay private —
# Google Maps browser keys should be HTTP-referrer restricted in Google Cloud.
#
# Copy to `.env.local` and restart `npm run dev`.

# Dev-only: set to 1 with `npm run dev:full` to enable the Hono API + Postgres bootstrap.
# Leave unset (default) for fast Vite-only `npm run dev`.
# VITE_ENABLE_API=1

# Optional product label
# VITE_APP_NAME=PropertyFlow

# Dev-only RoleSwitcher (persona hopping). Leave unset for real auth UX.
# VITE_DEMO_SWITCHER=1

# Google Maps Platform (optional — Maps JavaScript API + Geocoding + Places recommended)
# 1. Google Cloud → enable Maps JavaScript API (and Places if using address autocomplete)
# 2. Credentials → API key → Application restrictions: HTTP referrers
#    e.g. http://localhost:5173/*  https://*.vercel.app/*
# 3. Paste the key below. Leave blank to use the branded Leaflet/Carto Positron map (no key required).
# When set, the browse / listing maps use PropertyFlow-styled Google Maps instead.
VITE_GOOGLE_MAPS_API_KEY=

# Optional base for demo document sample PDFs (defaults to a stable W3C sample PDF)
# VITE_DEMO_DOCS_BASE_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources

# --- Server-only (Hono API — never use VITE_ prefix) ---
# The API reads this same root file. There is no separate server/.env.
#
# Local Supabase CLI database (`supabase status` → DB URL). Default port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional password for local seed accounts (`npm run db:seed:local` and the
# other scripts under scripts/seed). If unset, the script generates a strong
# password and prints it once. Do not commit a password here.
# SEED_USER_PASSWORD=

# API_PORT=8787
# Signs Hono session tokens. Local placeholder only — generate your own with
# `openssl rand -hex 32` and do not reuse this value anywhere but a laptop.
AUTH_SECRET=local-dev-auth-secret-not-for-any-hosted-environment-0001

# Comma-separated extra browser origins for CORS (Vercel preview URLs are auto-allowed)
# CORS_ORIGINS=https://propertyflow.example.com

# Set on Vercel: NODEJS_HELPERS=0 (Hono POST compatibility)
# NODEJS_HELPERS=0

# Optional: absolute API origin if not using the Vite `/api` proxy
# VITE_API_BASE=

# Supabase local API (`supabase status`).
# The anon and service_role JWTs below are the CLI's default local demo keys
# (ANON_KEY and SERVICE_ROLE_KEY). They are the same on every machine that
# uses the default local JWT secret. Confirm with `supabase status -o env`
# and paste over these if your status output differs (newer CLIs also print
# PUBLISHABLE_KEY / SECRET_KEY; either pair works for this app).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server copies of the same local project. Never point these at a hosted project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Legacy Next.js env names (optional compatibility)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- PayFast ---
# Leave blank for local development. Do not paste sandbox or live merchant keys
# into a shared env file. The app stays in sandbox mode if these are empty.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PAYFAST_PUBLIC_URL=http://127.0.0.1:5173

# --- Mail ---
# Email confirmations are on in supabase/config.toml. Sign-ups are not
# pre-confirmed. Confirmation messages are captured by the local mail catcher
# that `supabase start` provides (Mailpit / Inbucket) at http://127.0.0.1:54324.
# Leave Mailtrap empty. Do not use a hosted inbox.
MAILTRAP_TRANSPORT=
# SMTP credentials: https://mailtrap.io/inboxes → SMTP Settings (sandbox host
# is sandbox.smtp.mailtrap.io, ports 25/465/587/2525).
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# API alternative: token with Send access https://mailtrap.io/settings/api-tokens
# Delivery logs: https://mailtrap.io/sending/email_logs
# API sandbox sends need MAILTRAP_INBOX_ID; set MAILTRAP_USE_SANDBOX=false for
# live sending from a verified domain (https://mailtrap.io/domains).
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=PropertyFlow
# Recipient for `npm run email:test`
MAILTRAP_TEST_TO=
