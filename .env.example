# PropertyFlow is a Vite SPA. Only VITE_* vars are exposed to the client bundle.
# Do not put secrets here or in any VITE_* variable that must stay private —
# Google Maps browser keys should be HTTP-referrer restricted in Google Cloud.
#
# Copy to `.env.local` and restart `npm run dev`.

# Dev-only: set to 1 with `npm run dev:full` to enable the Hono API + Postgres bootstrap.
# Leave unset (default) for fast Vite-only `npm run dev`.
# VITE_ENABLE_API=1

# Optional product label
# VITE_APP_NAME=PropertyFlow

# Dev-only RoleSwitcher (persona hopping). Leave unset for real auth UX.
# VITE_DEMO_SWITCHER=1

# Google Maps Platform (optional — Maps JavaScript API + Geocoding + Places recommended)
# 1. Google Cloud → enable Maps JavaScript API (and Places if using address autocomplete)
# 2. Credentials → API key → Application restrictions: HTTP referrers
#    e.g. http://localhost:5173/*  https://*.vercel.app/*
# 3. Paste the key below. Leave blank to use the branded Leaflet/Carto Positron map (no key required).
# When set, the browse / listing maps use PropertyFlow-styled Google Maps instead.
VITE_GOOGLE_MAPS_API_KEY=

# Optional base for demo document sample PDFs (defaults to a stable W3C sample PDF)
# VITE_DEMO_DOCS_BASE_URL=https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources

# --- Server-only (Hono API — never use VITE_ prefix) ---
# Local Postgres (auto-used when DATABASE_URL is unset — see server/dbConfig.ts):
# DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/propertyflow
#
# Required on Vercel (Production + Preview) — redeploy after changing any of these:
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# AUTH_SECRET=<long random string>
# VITE_ENABLE_API=1
# NODEJS_HELPERS=0
# Supabase Postgres — Session/direct (migrations, port 5432):
# DIRECT_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# API_PORT=8787
# REQUIRED: AUTH_SECRET must be set to a unique, cryptographically secure random string
# Generate a secure value: openssl rand -hex 32
# This is used to sign all JWT session tokens. DO NOT use the default below in production.
# If running locally with a placeholder, use: openssl rand -hex 32 | tr -d '\n'
AUTH_SECRET=

# Comma-separated extra browser origins for CORS (Vercel preview URLs are auto-allowed)
# CORS_ORIGINS=https://propertyflow.example.com

# Set on Vercel: NODEJS_HELPERS=0 (Hono POST compatibility)
# NODEJS_HELPERS=0

# Optional: absolute API origin if not using the Vite `/api` proxy
# VITE_API_BASE=

# Supabase (client — safe to expose via VITE_ prefix)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Supabase (server — set in Vercel, never prefix with VITE_)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Legacy Next.js env names (optional compatibility)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project ref (docs / CLI — supabase link --project-ref ...)
# SUPABASE_PROJECT_REF=

# --- Firebase (client SDK — public config; lock API key by HTTP referrer in Google Cloud) ---
# Primary PMS data stays in Postgres. Firebase is for Auth/Storage/Firestore extras.
# Project: propertyflow-sa  Console: https://console.firebase.google.com/project/propertyflow-sa
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=propertyflow-sa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=propertyflow-sa
VITE_FIREBASE_STORAGE_BUCKET=propertyflow-sa.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=598142669344
VITE_FIREBASE_APP_ID=

# --- PayFast ---
# Sandbox credentials from https://sandbox.payfast.co.za (Merchant settings).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
PAYFAST_PUBLIC_URL=http://127.0.0.1:5173

# --- Mailtrap (transactional email) ---
# Transport: 'smtp' (default when SMTP creds present) or 'api'.
MAILTRAP_TRANSPORT=
# SMTP credentials: https://mailtrap.io/inboxes → SMTP Settings (sandbox host
# is sandbox.smtp.mailtrap.io, ports 25/465/587/2525).
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# API alternative: token with Send access https://mailtrap.io/settings/api-tokens
# Delivery logs: https://mailtrap.io/sending/email_logs
# API sandbox sends need MAILTRAP_INBOX_ID; set MAILTRAP_USE_SANDBOX=false for
# live sending from a verified domain (https://mailtrap.io/domains).
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=PropertyFlow
# Recipient for `npm run email:test`
MAILTRAP_TEST_TO=
