rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default — Letkaya ops data stays behind the Hono/Postgres API.
    // Client SDK may only touch explicit public/demo paths once Auth is wired.
    match /{document=**} {
      allow read, write: if false;
    }

    // Health ping used to verify the web SDK can reach Firestore (admin/rules later).
    match /_meta/health {
      allow read: if true;
      allow write: if false;
    }
  }
}
