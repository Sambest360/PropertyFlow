{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["arn1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{server/**,src/lib/**,src/types/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/lease-reminders", "schedule": "0 5 * * *" },
    { "path": "/api/cron/screening-purge", "schedule": "30 1 * * *" },
    { "path": "/api/cron/storage-alerts", "schedule": "15 6 * * *" },
    { "path": "/api/cron/escalations", "schedule": "0 * * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|svg|png|jpg|jpeg|webp|woff2|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/qa-guide", "destination": "/qa-guide.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
