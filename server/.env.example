# Server-only PayFast credentials. Never put these in VITE_* vars or client code.
# Create a sandbox account at https://sandbox.payfast.co.za and paste the values
# from Merchant settings. Use a different live account when PAYFAST_MODE=live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# sandbox (default) or live. Live refuses to start without PAYFAST_PASSPHRASE.
PAYFAST_MODE=sandbox

# Public origin used for return, cancel and notify URLs.
PAYFAST_PUBLIC_URL=http://127.0.0.1:5173

# ITN client IP. The check reads this one header and ignores every caller
# forwarding header (X-Forwarded-For, Forwarded, X-Client-IP, and the rest).
# Vercel overwrites x-real-ip. There is no fallback when the header is missing.
# Set to x-forwarded-for or forwarded only if your proxy appends the client
# address and you count hops with PAYFAST_TRUSTED_PROXY_HOPS (from the right).
# PAYFAST_CLIENT_IP_HEADER=x-real-ip
# PAYFAST_TRUSTED_PROXY_HOPS=1
# Extra ITN source IPs for a local simulator, comma-separated. The PayFast
# allow-list still applies in sandbox and live.
# PAYFAST_ITN_EXTRA_IPS=

# Local QA only. Never set these on Vercel or any shared host.
# PAYFAST_ITN_LOCAL=1 makes the platform address come from
# PAYFAST_ITN_PLATFORM_IP, or from X-PF-Platform-IP when the request also
# sends X-PF-Platform-Secret matching PAYFAST_ITN_PLATFORM_SECRET.
# A normal request cannot set that address. x-real-ip is ignored in this mode.
# PAYFAST_ITN_LOCAL=1
# PAYFAST_ITN_PLATFORM_SECRET=
# PAYFAST_ITN_PLATFORM_IP=
# PAYFAST_ITN_PLATFORM_IP_HEADER=x-pf-platform-ip
# PAYFAST_ITN_PLATFORM_SECRET_HEADER=x-pf-platform-secret

# Validate postback. Unset, the server calls PayFast's sandbox or live URL.
# Point this at a local stub to avoid calling PayFast. The server posts the
# ITN fields only; caller headers are not forwarded.
# PAYFAST_VALIDATE_URL=http://127.0.0.1:8799/validate
# In-process stub. Requires PAYFAST_ITN_LOCAL=1 and a matching platform secret.
# The result is X-PF-Validate-Stub: VALID, INVALID, or ERROR. Anything else
# is treated as INVALID. Without the secret the ITN is rejected and PayFast
# is not called.
# PAYFAST_VALIDATE_STUB=1
# PAYFAST_VALIDATE_STUB_HEADER=x-pf-validate-stub

# Postgres TLS. Remote connections verify the server certificate
# (rejectUnauthorized true). Plain connections are allowed only to localhost.
# Supabase's pooler often needs its CA. Paste the PEM or point at a file.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL_CA_FILE=/path/to/supabase-ca.pem
